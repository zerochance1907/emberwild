{
  "name": "emberwild",
  "private": true,
  "version": "0.2.0",
  "description": "An original monster-taming RPG for the browser.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
